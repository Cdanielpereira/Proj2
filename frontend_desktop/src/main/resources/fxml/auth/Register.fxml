<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="auth.RegisterController"
           prefWidth="900" prefHeight="600">

    <VBox alignment="CENTER" maxWidth="420" spacing="14">
        <padding><Insets top="32" right="36" bottom="32" left="36"/></padding>

        <Label text="Criar conta" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label text="Username"/>
        <TextField fx:id="usernameField" promptText="O seu username"/>

        <Label text="Email"/>
        <TextField fx:id="emailField" promptText="email@exemplo.com"/>

        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="••••••••"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: #c0392b;"
               visible="false" managed="false"/>

        <Button text="Registar" onAction="#handleRegister"
                defaultButton="true" maxWidth="Infinity"/>

        <Hyperlink text="Voltar" onAction="#handleBackToHome"/>
    </VBox>
</StackPane>