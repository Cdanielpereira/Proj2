<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.FormScreenController">

    <!-- TITLE -->
    <top>
        <Label fx:id="titleLabel"
               text="Form"
               style="-fx-font-size: 18px; -fx-padding: 10;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- FORM AREA (DINÂMICO) -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="formContainer"
                  spacing="12"
                  style="-fx-padding: 20;"/>
        </ScrollPane>
    </center>

    <!-- ACTION BUTTONS (fixos) -->
    <bottom>
        <HBox spacing="10"
              style="-fx-padding: 15;"
              alignment="CENTER_RIGHT">

            <Button fx:id="cancelButton"
                    text="Cancelar"
                    style="-fx-background-color: #870303; -fx-text-fill: white;"/>

            <Button fx:id="saveButton"
                    text="Guardar"
                    style="-fx-background-color: #026001; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>